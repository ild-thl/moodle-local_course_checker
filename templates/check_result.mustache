{{!
    @template local_course_checker/check_result

    Renders a single result line for a course checker result.

    Example context (json):
    {
        "title": "Quiz 1: Due date is missing",
        "link": "https://moodle.example.com/mod/quiz/view.php?id=42",
        "message": "Please add a due date to this activity.",
        "text_class": "text-danger"
    }
}}

<div class="row align-items-center m-0 p-3 border-bottom">
    <div class="col-1 p-0">
        <span class="icon-size-5 {{text_class}}">{{{icon}}}</span>
    </div>
    <div class="col-11 p-0">
        {{#link}}<a href="{{link}}" class="text-reset" target="_blank">{{/link}}{{^link}}<span>{{/link}}
        {{title}}
        {{^link}}</span>{{/link}}{{#link}}</a>{{/link}}
        {{#currentclaims}}
        <section class="mt-2 mb-1" aria-label="{{labelstatus}}">
            <div class="mb-2 text-body">
                <strong>{{labellocation}}:</strong>
                {{^haslocationlinks}}{{locations}}{{/haslocationlinks}}
                {{#haslocationlinks}}
                    <ul class="mb-0 ps-3">
                        {{#locationlinks}}
                            <li>
                                <div class="fw-semibold mb-1">{{label}}</div>
                                    <div class="d-flex flex-wrap gap-3 mb-2">
                                        {{#viewurl}}
                                            <a class="text-primary text-decoration-underline" href="{{viewurl}}">
                                                <i class="fa fa-external-link me-1" aria-hidden="true"></i>
                                                {{viewlabel}}
                                            </a>
                                        {{/viewurl}}
                                        {{#editurl}}
                                            <a class="text-primary text-decoration-underline" href="{{editurl}}">
                                                <i class="fa fa-pencil me-1" aria-hidden="true"></i>
                                                {{editlabel}}
                                            </a>
                                        {{/editurl}}
                                    </div>
                            </li>
                        {{/locationlinks}}
                    </ul>
                {{/haslocationlinks}}
            </div>
            <div class="mb-2 text-body"><strong>{{labeloriginal}}:</strong> {{original}}</div>
            {{#variants}}
                <div class="mb-1 small text-muted"><strong>{{labelvariants}}:</strong> {{text}}</div>
            {{/variants}}
            <div class="mb-2 text-body"><strong>{{labelclaim}}:</strong> {{claim}}</div>
            <div class="mb-2 {{text_class}}"><strong>{{labelstatus}}:</strong> {{status}}</div>
            <div class="mb-2 text-body"><strong>{{labelreason}}:</strong> {{reason}}</div>
            {{#hasparts}}
                <div class="border rounded p-2 mb-2 text-body">
                    <strong>{{labelparts}}</strong>
                    <ul class="mb-0 ps-3">
                        {{#parts}}
                            <li>{{label}}: <strong>{{status}}</strong>
                                {{#url}}<a class="small text-break" href="{{url}}"
                                    target="_blank" rel="noopener noreferrer">{{url}}</a>{{/url}}
                            </li>
                        {{/parts}}
                    </ul>
                </div>
            {{/hasparts}}
            {{#hascorrection}}
                <div class="border rounded p-2 mb-2 bg-light text-body">
                    <strong>{{labelcorrection}}</strong>
                    <p class="mb-1 mt-1">{{correction}}</p>
                    <small class="text-muted">{{correctionnotice}}</small>
                </div>
            {{/hascorrection}}
            {{#hassources}}
                <div class="mt-2 text-body"><strong>{{labelsources}}</strong></div>
                <ul class="small mb-1 ps-3">
                    {{#sources}}
                        <li>
                            <a href="{{url}}" target="_blank" rel="noopener noreferrer">{{label}}</a>
                            {{#date}}<span class="text-muted">({{date}})</span>{{/date}}
                        </li>
                    {{/sources}}
                </ul>
                <small class="text-muted">{{sourcenotice}}</small>
            {{/hassources}}
            {{#hasdiagnostic}}
                <div class="small text-muted mt-2">{{labeldiagnostic}}: {{diagnostic}}</div>
            {{/hasdiagnostic}}
        </section>
        {{/currentclaims}}
        {{^currentclaims}}
        <span class="{{text_class}}">{{message}}</span>
        {{/currentclaims}}
        {{#currentclaimslocationlinks}}
            <div class="small mt-1 text-body">
                {{label}}
                {{#viewurl}}<a class="ms-2" href="{{viewurl}}">{{viewlabel}}</a>{{/viewurl}}
                {{#editurl}}<a class="ms-2" href="{{editurl}}">{{editlabel}}</a>{{/editurl}}
            </div>
        {{/currentclaimslocationlinks}}
        {{#link_checker_additional}}
            &nbsp;-&nbsp;
            <a href="{{.}}" class="ms-2" target="_blank" rel="noopener" title="{{.}}">
                <i class="icon fa fa-external-link text-muted"></i>
            </a>
        {{/link_checker_additional}}
    </div>
</div>
